# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_TELEGRAM_IDS=your_numeric_telegram_id

# Storage and limits
ADMIN_STORAGE_DIR=admin_storage
DATABASE_PATH=bot.db
MAX_UPLOAD_MB=unlimited

# OpenRouter AI Configuration (Model: google/gemini-2.5-flash)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Paid Telegram Quiz Channel (₹99 Access)
PAID_CHANNEL_LINK=https://t.me/+EjtGp-pH4hMxZDM1
PAID_CHANNEL_ID=
CHANNEL_FEE_INR=99

# Force-Subscribe Free Channel (Optional - Leave blank to allow open access)
FORCE_SUB_CHANNEL_ID=

# UPI Direct Payment Gateway Details (GPay / PhonePe / Paytm / BHIM)
UPI_ID=your_upi_id@upi
UPI_NAME=ExamRankers

# Optional Razorpay Payment Gateway Integration (Leave blank to use Direct UPI Gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Sponsored Ads, YouTube & Affiliate Monetization
ENABLE_ADS=false
SPONSOR_AD_TEXT=🔥 <b>Top Recommended Test Series & Study Notes!</b>\nGet exclusive discounts & free mock tests with code <b>TOPRANK</b>.
AFFILIATE_LINK=https://t.me/your_partner_link
YOUTUBE_CHANNEL_LINK=https://youtube.com/@ExamRankers
YOUTUBE_BUTTON_TEXT=🔴 अधिकृत YouTube चॅनेल (Subscribe)

# SMTP Automated Email Delivery for Paid Digital Store Products (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=ExamRankers Store <your_email@gmail.com>
