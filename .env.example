# 1. Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
ADMIN_TELEGRAM_IDS=705909048
TELEGRAM_API_ID=YOUR_API_ID
TELEGRAM_API_HASH=YOUR_API_HASH

# 2. Administrative & Cryptographic Security
ADMIN_API_KEY=admin_prod_examrankers_sec_997009
DOWNLOAD_SECRET_KEY=5a0797f256a3607d91b3556a282939a0e5c7d86b5cfb058f1489399e336303a4
TRUSTED_PROXIES=127.0.0.1,::1

# 3. Persistent Storage and File Size Ceilings
MAX_UPLOAD_MB=unlimited
ADMIN_STORAGE_DIR=admin_storage
DATABASE_PATH=bot.db
DATA_DIR=data
PORT=8080
WEB_CONCURRENCY=1

# 4. OpenClaw Autonomous Multi-Agent Configuration (Real OpenClaw.ai Engine)
OPENCLAW_CONFIG_PATH=openclaw.json
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_BIND=loopback
OPENCLAW_STATE_DIR=admin_storage/.openclaw
ENABLE_OPENCLAW_AUTONOMOUS_CYCLE=true
AUTO_SELL_DAEMON_ENABLED=true
OPENCLAW_CYCLE_INTERVAL_SECONDS=1800
AUTO_SELL_INTERVAL_SECONDS=1800
ENABLE_AUTO_PROMO=true
ENABLE_AUTO_MINDMAP=true
ENABLE_AUTO_YT_BROADCAST=false
ENABLE_AUTO_EBOOK_GENERATION=true

# 5. AI Specialist Agents Configuration (100% Free Tiers - Zero Billing)
AI_PROVIDER_CHAIN=openrouter_free,google_free,offline
OPENROUTER_API_KEY=YOUR_OPENROUTER_FREE_API_KEY
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
AI_DAILY_CAP=500
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_HOST=http://localhost:11434

# 6. Paid VIP Telegram Channel & Quizzes
PAID_CHANNEL_LINK=https://t.me/+EjtGp-pH4hMxZDM1
PAID_CHANNEL_ID=-1004381339759
CHANNEL_FEE_INR=99
FORCE_SUB_CHANNEL_ID=
