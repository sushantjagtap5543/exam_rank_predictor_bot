# ==============================================================================
# ExamRankers Production Environment Configuration
# ==============================================================================

# 1. Telegram Bot Credentials
# Obtain bot token from @BotFather in Telegram.
# NEVER commit your real token to Git. If leaked, revoke immediately via @BotFather.
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_TELEGRAM_IDS=your_numeric_telegram_id_here

# Telegram MTProto Client Credentials (own API ID / Hash - obtain from my.telegram.org)
# NEVER use default 2040. Leave blank to disable MTProto direct downloader.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 2. Administrative Security
# Required for all /api/admin/* POST routes and /admin/* dashboard views.
# Must match X-Admin-Key header using constant-time HMAC comparison.
# If unset, all admin endpoints are completely disabled for security.
ADMIN_API_KEY=your_strong_random_secret_hex_key_here

# Secret key used for signing time-limited, tamper-proof download URLs (HMAC-SHA256)
DOWNLOAD_SECRET_KEY=your_random_download_signing_secret_here

# Trusted reverse proxies for rate-limiting client IP resolution (comma-separated)
TRUSTED_PROXIES=127.0.0.1,::1

# 3. Persistent Storage and Volume Mounts
# Set DATA_DIR to your cloud persistent volume mount point (e.g. /var/data or /data)
DATA_DIR=
ADMIN_STORAGE_DIR=admin_storage
DATABASE_PATH=bot.db
MAX_UPLOAD_MB=unlimited

# 4. Cashfree Payment Gateway (Primary Payment Provider - replaces Razorpay & manual UTR)
# Create account at https://www.cashfree.com/ and get credentials from Merchant Dashboard.
# CASHFREE_ENV: TEST (sandbox) or PROD (production)
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENV=TEST
CASHFREE_WEBHOOK_URL=https://your-domain.com/api/cashfree/webhook

# 5. Free AI Models Configuration (Strictly 100% Free Tiers - Zero Billing Required)
# AI_PROVIDER_CHAIN: google_free,openrouter_free,groq_free,ollama,offline
# Any OpenRouter model ID not ending in ':free' is rejected at startup.
AI_PROVIDER_CHAIN=google_free,openrouter_free,groq_free,offline
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_HOST=http://localhost:11434
AI_DAILY_CAP=500

# 6. Paid Telegram Quiz Channel (Rs 99 VIP Access via Cashfree)
PAID_CHANNEL_LINK=https://t.me/+YourPrivateChannelInviteLink
PAID_CHANNEL_ID=
CHANNEL_FEE_INR=99

# Force-Subscribe Free Channel (Optional - Leave blank to allow open access)
FORCE_SUB_CHANNEL_ID=

# Optional Manual Fallback UPI (Disabled by default; requires admin manual approval)
ENABLE_MANUAL_UPI_FALLBACK=false
UPI_ID=
UPI_NAME=ExamRankers

# 7. Sponsored Ads, YouTube & Marketing (Manual Admin Control Mode by Default)
ENABLE_ADS=false
ENABLE_AUTO_PROMO=false
ENABLE_AUTO_QUIZ_POSTING=false
ENABLE_AUTO_EBOOK_GENERATION=false
# Pacing: 17.0s delay = 3 to 4 quizzes per minute (steady, anti-flood)
QUIZ_POST_DELAY_SECONDS=17.0
SPONSOR_AD_TEXT=
SPONSOR_AD_BUTTON_TEXT=
SPONSOR_AD_URL=
YOUTUBE_CHANNEL_LINK=https://youtube.com/@ExamRankers
YOUTUBE_BUTTON_TEXT=🔴 अधिकृत YouTube चॅनेल (Subscribe)

# 8. Web Server & Self-Ping (Keep-Alive)
PORT=8080
SELF_PING_URL=

# 9. SMTP Automated Email Delivery for Paid Digital Store Products (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=ExamRankers Store <support@examrankers.com>

# 10. Optional Sentry Error Monitoring
SENTRY_DSN=
