# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_TELEGRAM_IDS=your_numeric_telegram_id

# Storage and limits
ADMIN_STORAGE_DIR=admin_storage
DATABASE_PATH=bot.db
MAX_UPLOAD_MB=unlimited

# OpenRouter AI Configuration (Ultra-low cost or free model: google/gemini-2.0-flash-001 or google/gemini-2.0-flash-lite-preview-02-05:free)
OPENROUTER_API_KEY=your_openrouter_paid_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Paid Telegram Quiz Channel (₹99 Access)
PAID_CHANNEL_LINK=https://t.me/+EjtGp-pH4hMxZDM1
PAID_CHANNEL_ID=
CHANNEL_FEE_INR=99

# UPI Payment Details for ₹99 Channel Access
UPI_ID=your_upi_id@upi
UPI_NAME=ExamRankers

# Sponsored Ads, YouTube & Affiliate Monetization
ENABLE_ADS=true
SPONSOR_AD_TEXT=🔥 <b>Top Recommended Test Series & Study Notes!</b>\nGet exclusive discounts & free mock tests with code <b>TOPRANK</b>.
SPONSOR_AD_BUTTON_TEXT=🎯 View Exam Test Series & Free Mocks
SPONSOR_AD_URL=https://t.me/your_channel_or_affiliate_link

# YouTube Channel & Social Community Advertising
YOUTUBE_CHANNEL_LINK=https://youtube.com/@YourYouTubeChannel
YOUTUBE_BUTTON_TEXT=🔴 अधिकृत YouTube चॅनेल (Subscribe)

# 24/7 Render Keep-Alive Self-Pinger (Paste your Render Web Service URL)
SELF_PING_URL=https://exam-rank-predictor-bot.onrender.com

# Automated Email Delivery for ExamRankers Digital Products Store (SMTP)
# (e.g. Gmail App Password, SendGrid, Amazon SES, or custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
SENDER_EMAIL=support@examrankers.com
