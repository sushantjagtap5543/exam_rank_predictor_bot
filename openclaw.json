{
  "$schema": "https://openclaw.ai/schema/openclaw.json",
  "gateway": {
    "port": 18789,
    "bind": "loopback"
  },
  "channels": {
    "telegram": {
      "enabled": true
    }
  },
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "systemAgent": {
        "agentId": "ceo"
      },
      "workspace": ".",
      "subagents": {
        "maxConcurrent": 8,
        "model": "nvidia/nemotron-3.5-lightning:free"
      }
    },
    "entries": {
      "ceo": {
        "name": "Dr. Vikramaditya Deshmukh (CEO)",
        "description": "Chief Executive Officer & Enterprise Orchestrator | 25+ Years Experience",
        "tools": {
          "profile": "full",
          "allow": ["sessions_spawn", "sessions_yield", "subagents"]
        },
        "subagents": {
          "allowAgents": [
            "policy",
            "market",
            "community_harvest",
            "community_engage",
            "mpsc_dean",
            "civil_faculty",
            "mech_faculty",
            "quality_auditor",
            "product_factory",
            "growth",
            "counselor"
          ]
        }
      },
      "policy": {
        "name": "Adv. Shrikant Joshi",
        "description": "Anti-Ban & Policy Guardian | 20+ Years Experience",
        "tools": {
          "profile": "minimal",
          "allow": ["rate_limit", "jitter", "floodwait_backoff"]
        }
      },
      "market": {
        "name": "Prof. Ananya Patil",
        "description": "Market Intelligence & Demand Harvester | 20+ Years Experience",
        "tools": {
          "profile": "coding",
          "allow": ["trend_harvest", "syllabus_tracker"]
        }
      },
      "community_harvest": {
        "name": "Ms. Supriya Sawant",
        "description": "Community Intelligence & Student Needs Harvester | 20+ Years Experience",
        "tools": {
          "profile": "messaging",
          "allow": ["pain_point_extractor", "spec_synthesizer"]
        }
      },
      "community_engage": {
        "name": "Mr. Swapnil Salunkhe",
        "description": "Community Engagement & News Brand Shield | 20+ Years Experience",
        "tools": {
          "profile": "messaging",
          "allow": ["group_chat", "brand_filter", "news_curate"]
        }
      },
      "mpsc_dean": {
        "name": "Dr. Ravindra Deshmukh",
        "description": "MPSC Academic Dean | 22+ Years Experience",
        "tools": {
          "profile": "full",
          "allow": ["mpsc_curriculum", "gs_benchmarking"]
        }
      },
      "civil_faculty": {
        "name": "Prof. Rajesh K. Joshi, FIE",
        "description": "Civil Engineering Faculty Chair | 24+ Years Experience",
        "tools": {
          "profile": "full",
          "allow": ["is456_schematics", "som_rcc_design"]
        }
      },
      "mech_faculty": {
        "name": "Dr. Amit Sharma",
        "description": "Mechanical Engineering Faculty Chair | 21+ Years Experience",
        "tools": {
          "profile": "full",
          "allow": ["otto_pv_cycle", "thermodynamics"]
        }
      },
      "quality_auditor": {
        "name": "Dr. Prachi Kulkarni",
        "description": "Chief Publication Designer & Accuracy Auditor | 20+ Years Experience",
        "tools": {
          "profile": "full",
          "allow": ["devanagari_lint", "answer_key_audit"]
        }
      },
      "product_factory": {
        "name": "Eng. Rohan Kulkarni",
        "description": "Autonomous Product Factory | 20+ Years Experience",
        "tools": {
          "profile": "full",
          "allow": ["reportlab_pdf_synthesis", "vector_drawing", "catalog_publish"]
        }
      },
      "growth": {
        "name": "Mr. Sameer Inamdar",
        "description": "Viral Growth & Conversion Director | 20+ Years Experience",
        "tools": {
          "profile": "messaging",
          "allow": ["channel_broadcast", "scarcity_copy"]
        }
      },
      "counselor": {
        "name": "Mr. Nilesh Dada",
        "description": "Senior Student Counselor & Mentor | 20+ Years Experience",
        "tools": {
          "profile": "messaging",
          "allow": ["human_empathy_dm", "weak_area_diagnostic"]
        }
      }
    }
  }
}
