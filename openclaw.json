{
  "$schema": "https://openclaw.ai/schema/openclaw.json",
  "gateway": {
    "port": 8080,
    "host": "0.0.0.0",
    "channel": "telegram"
  },
  "agents": {
    "defaults": {
      "workspace": ".",
      "soul": "SOUL.md",
      "agents": "AGENTS.md",
      "memory": "MEMORY.md",
      "subagents": {
        "maxConcurrent": 8,
        "model": "nvidia/nemotron-3.5-lightning:free",
        "announce": {
          "showStats": true
        }
      }
    },
    "list": [
      {
        "id": "ceo",
        "name": "Dr. Vikramaditya Deshmukh (CEO)",
        "role": "Chief Executive Officer & Enterprise Orchestrator",
        "seniority": "25+ Years Experience",
        "tools": { "profile": "full", "allow": ["sessions_spawn", "sessions_yield", "subagents"] },
        "subagents": { "allowAgents": ["policy", "market", "community_harvest", "community_engage", "mpsc_dean", "civil_faculty", "mech_faculty", "quality_auditor", "product_factory", "growth", "counselor"] }
      },
      {
        "id": "policy",
        "name": "Adv. Shrikant Joshi",
        "role": "Anti-Ban & Policy Guardian",
        "seniority": "20+ Years Experience",
        "tools": { "profile": "compliance", "allow": ["rate_limit", "jitter", "floodwait_backoff"] }
      },
      {
        "id": "market",
        "name": "Prof. Ananya Patil",
        "role": "Market Intelligence & Demand Harvester",
        "seniority": "20+ Years Experience",
        "tools": { "profile": "research", "allow": ["trend_harvest", "syllabus_tracker"] }
      },
      {
        "id": "community_harvest",
        "name": "Ms. Supriya Sawant",
        "role": "Community Intelligence & Student Needs Harvester",
        "seniority": "20+ Years Experience",
        "tools": { "profile": "harvest", "allow": ["pain_point_extractor", "spec_synthesizer"] }
      },
      {
        "id": "community_engage",
        "name": "Mr. Swapnil Salunkhe",
        "role": "Community Engagement & News Brand Shield",
        "seniority": "20+ Years Experience",
        "tools": { "profile": "community", "allow": ["group_chat", "brand_filter", "news_curate"] }
      },
      {
        "id": "mpsc_dean",
        "name": "Dr. Ravindra Deshmukh",
        "role": "MPSC Academic Dean",
        "seniority": "22+ Years Experience",
        "tools": { "profile": "academic", "allow": ["mpsc_curriculum", "gs_benchmarking"] }
      },
      {
        "id": "civil_faculty",
        "name": "Prof. Rajesh K. Joshi, FIE",
        "role": "Civil Engineering Faculty Chair",
        "seniority": "24+ Years Experience",
        "tools": { "profile": "engineering", "allow": ["is456_schematics", "som_rcc_design"] }
      },
      {
        "id": "mech_faculty",
        "name": "Dr. Amit Sharma",
        "role": "Mechanical Engineering Faculty Chair",
        "seniority": "21+ Years Experience",
        "tools": { "profile": "engineering", "allow": ["otto_pv_cycle", "thermodynamics"] }
      },
      {
        "id": "quality_auditor",
        "name": "Dr. Prachi Kulkarni",
        "role": "Chief Publication Designer & Accuracy Auditor",
        "seniority": "20+ Years Experience",
        "tools": { "profile": "quality", "allow": ["devanagari_lint", "answer_key_audit"] }
      },
      {
        "id": "product_factory",
        "name": "Eng. Rohan Kulkarni",
        "role": "Autonomous Product Factory",
        "seniority": "20+ Years Experience",
        "tools": { "profile": "publication", "allow": ["reportlab_pdf_synthesis", "vector_drawing", "catalog_publish"] }
      },
      {
        "id": "growth",
        "name": "Mr. Sameer Inamdar",
        "role": "Viral Growth & Conversion Director",
        "seniority": "20+ Years Experience",
        "tools": { "profile": "marketing", "allow": ["channel_broadcast", "scarcity_copy"] }
      },
      {
        "id": "counselor",
        "name": "Mr. Nilesh Dada",
        "role": "Senior Student Counselor & Mentor",
        "seniority": "20+ Years Experience",
        "tools": { "profile": "counseling", "allow": ["human_empathy_dm", "weak_area_diagnostic"] }
      }
    ]
  }
}
